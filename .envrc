# `nix develop` points TMPDIR at a scratch directory it deletes on exit.
# Anything an editor spawns from this environment (rust-analyzer's
# proc-macro server, for one) needs a temp dir that still exists, so keep
# the one we started with.
tmpdir="${TMPDIR:-/tmp}"

use flake

export TMPDIR="$tmpdir"
unset TEMP TMP TEMPDIR
